@model IEnumerable<NZWalks.UI.Models.DTO.RegionDto>

@{
    ViewData["Title"] = "Regions";
}

<h1>Regions</h1>
<div class="d-flex justify-content-end">\
    <a class="btn btn-secondary" asp-controller="Regions" asp-action="Add" >Add Region</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @ViewBag.Error
    </div>
}

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Code</th>
                <th>Region Image URL</th>
                <th> </th>
            </tr>
        </thead>
         
        <tbody>
            @foreach (var region in Model)
            {
                <tr>
                    <td>@region.Id</td>
                    <td>@region.Name</td>
                    <td>@region.Code</td>
                    <td>@region.RegionImageUrl</td>
                    <td>
                        <a asp-controller="Regions" asp-action="Edit" asp-route-id= "@region.Id" class="btn btn-light"> Edit </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (ViewBag.Error == null)
{
    <p>No regions found.</p>
}